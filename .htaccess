# clima.jaureguitosistemas.com
Options -Indexes
RewriteEngine On

# Páginas de cada mes: /enero … /diciembre
RewriteRule ^(enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre)/?$ mes.php?mes=$1 [L,QSA]

# Una sola URL por página
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+mes\.php\?mes=([a-z]+)[\s&] [NC]
RewriteRule ^ /%1? [R=301,L]

# Lo interno no se publica
RewriteRule ^(analisis|cache|\.github)(/|$) - [F,L]
<FilesMatch "\.(md|py|txt|yml|csv)$">
  Require all denied
</FilesMatch>
<Files "robots.txt">
  Require all granted
</Files>

# Caché del navegador para estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
